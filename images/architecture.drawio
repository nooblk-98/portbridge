<mxfile host="app.diagrams.net"><diagram id="pb" name="PortBridge Architecture"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="880" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="&lt;b style='font-size:18px'&gt;PortBridge – System Architecture&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="700" height="30" as="geometry"/></mxCell><mxCell id="n3" value="Administrator" style="swimlane;startSize=26;html=1;whiteSpace=wrap;collapsible=0;align=left;spacingLeft=10;fontStyle=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#ffffff;rounded=0;" vertex="1" parent="1"><mxGeometry x="30" y="111" width="180" height="130" as="geometry"/></mxCell><mxCell id="n4" value="Browser (HTTPS via reverse proxy)&lt;br&gt;• Manage peers and routes&lt;br&gt;• Split tunnel, QR codes&lt;br&gt;• Public port rules, status" style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;" vertex="1" parent="n3"><mxGeometry x="10" y="36" width="164" height="84" as="geometry"/></mxCell><mxCell id="n5" value="Internet users" style="swimlane;startSize=26;html=1;whiteSpace=wrap;collapsible=0;align=left;spacingLeft=10;fontStyle=1;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;swimlaneFillColor=#ffffff;rounded=0;" vertex="1" parent="1"><mxGeometry x="30" y="690" width="180" height="112" as="geometry"/></mxCell><mxCell id="n6" value="Public, unauthenticated&lt;br&gt;• Web / game / SSH clients" style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;" vertex="1" parent="n5"><mxGeometry x="10" y="36" width="164" height="64" as="geometry"/></mxCell><mxCell id="n7" value="Public VPS (internet-facing) – systemd service or Docker container" style="swimlane;startSize=26;html=1;whiteSpace=wrap;collapsible=0;align=left;spacingLeft